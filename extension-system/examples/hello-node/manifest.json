{
  "id": "hello-node",
  "name": "Hello Node Extension",
  "description": "Demonstrates a Node.js Mocu extension that can call the host (use the LLM) through Rust.",
  "version": "0.1.0",
  "runtime": "node",
  "entry": "index.js",
  "commands": [
    { "id": "hello", "title": "Say Hello", "description": "Echo back the input value." },
    { "id": "llm", "title": "Ask Host LLM", "description": "Call mocu.llm.generate through the host." }
  ]
}