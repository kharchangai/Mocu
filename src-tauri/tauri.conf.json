{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mocu",
  "version": "0.1.1",
  "identifier": "com.mocu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mocu",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "maximized": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#ffffff",
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "E:/test/testpage/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/install-resources-bundle/": "install-resources/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NEFGQTc5ODRCMDFBNUIKUldSYkdyQ0VlZnBLRjhyZHFueUhKS0MxU0hoMWhLcFVXWVUvamNIRFMyQkJPNXExakh0V1REeVgK",
      "endpoints": [
        "https://github.com/kharchangai/Mocu/releases/latest/download/latest.json"
      ]
    }
  }
}
