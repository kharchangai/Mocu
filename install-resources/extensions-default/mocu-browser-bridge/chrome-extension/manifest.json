{
  "manifest_version": 3,
  "name": "Mocu Browser Bridge",
  "version": "1.0.0",
  "description": "Connect Google Chrome to Mocu for agent-driven browsing and page interaction.",
  "key": "",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:38742;"
  },
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Mocu Browser Bridge" }
}
